DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.example.invalid
DATABASE_URL=postgresql://tnk_insight:change-me@db:5432/tnk_insight
POSTGRES_DB=tnk_insight
POSTGRES_USER=tnk_insight
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.invalid
DJANGO_SESSION_COOKIE_AGE=3600
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
TNK_PDF_FONT_PATH=
TNK_PDF_FONT_BOLD_PATH=
DJANGO_SECURE_SSL_REDIRECT=True
MOBILE_ACCESS_TOKEN_MINUTES=10
MOBILE_REFRESH_TOKEN_DAYS=7
MOBILE_LOGIN_RATE=5/minute
MOBILE_MINIMUM_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_LOG_LEVEL=INFO
TNK_LOG_LEVEL=INFO
DJANGO_CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://tile.openstreetmap.org https://unpkg.com; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; upgrade-insecure-requests
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
